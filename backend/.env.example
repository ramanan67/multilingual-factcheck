# Application Environment Settings
APP_NAME="Tamil & Multilingual News Truth Checker"
APP_ENV=development
DEBUG=true
PORT=8000
HOST=127.0.0.1

# Optional API Keys (Leave blank to use live RSS & Public Source Adapters)
NEWS_SEARCH_API_KEY=
TRANSLATION_API_KEY=
OPENAI_API_KEY=

# Search & Retrieval Limits
MAX_ARTICLES_PER_SOURCE=5
MAX_TOTAL_ARTICLES=40
REQUEST_TIMEOUT_SECONDS=10
CACHE_TTL_SECONDS=1800

# Database
DATABASE_URL=sqlite:///./truth_checker.db
