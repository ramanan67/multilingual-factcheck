# Google Programmable Search Engine (CSE)
# Create at https://programmablesearchengine.google.com/
# Restrict it to the 7 domains listed in app/core/config.py
GOOGLE_CSE_API_KEY=your_google_api_key_here
GOOGLE_CSE_ENGINE_ID=your_cse_engine_id_here

# Minimum number of independent whitelisted outlets required to mark a claim "Verified"
CONSENSUS_THRESHOLD=2

# How often (minutes) the background RSS ingestion worker runs
RSS_POLL_INTERVAL_MINUTES=15

# Where the local vector DB is persisted
CHROMA_PERSIST_DIR=./chroma_data

# Backend URL the Streamlit dashboard should call
API_BASE_URL=http://localhost:8000
